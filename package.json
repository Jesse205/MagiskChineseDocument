{
  "name": "magisk-chinese-document",
  "version": "31.1.0",
  "description": "Magisk 中文文档",
  "author": "Jesse205",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "serve": "vitepress serve",
    "preview": "vitepress preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "run-p lint:code lint:md",
    "lint:code": "oxlint --deny-warnings .",
    "lint:md": "rumdl check .",
    "lint:fix": "run-p lint:code:fix lint:md:fix",
    "lint:code:fix": "oxlint --fix .",
    "lint:md:fix": "rumdl check --fix .",
    "format": "run-p format:code format:md",
    "format:code": "oxfmt --write .",
    "format:md": "rumdl fmt .",
    "format:check": "run-p format:code:check format:md:check",
    "format:code:check": "oxfmt --check .",
    "format:md:check": "rumdl fmt --check ."
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rumdl": "^0.3.0",
    "sass": "^1.106.1",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.21",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
